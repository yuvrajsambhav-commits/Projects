generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { USER ADMIN }
enum VerificationStatus { NOT_STARTED PENDING VERIFIED FAILED EXPIRED }
enum RideStatus { CREATED UPCOMING STARTED COMPLETED CANCELLED NO_SHOW DISPUTED }
enum RequestStatus { PENDING ACCEPTED REJECTED CANCELLED EXPIRED }
enum PaymentStatus { NOT_REQUIRED PENDING PAID FAILED REFUNDED DISPUTED }
model College { id String @id @default(cuid()) name String @unique city String domain String? verificationEnabled Boolean @default(true) users User[] createdAt DateTime @default(now()) }
model User { id String @id @default(cuid()) name String email String @unique phone String @unique passwordHash String profilePhotoUrl String collegeId String? college College? @relation(fields:[collegeId],references:[id]) city String rating Float @default(0) completedRides Int @default(0) role Role @default(USER) identityStatus VerificationStatus @default(NOT_STARTED) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt vehicles Vehicle[] ridesDriven Ride[] @relation("Driver") requests RideRequest[] blocks Block[] @relation("Blocker") blockedBy Block[] @relation("Blocked") }
model Vehicle { id String @id @default(cuid()) ownerId String owner User @relation(fields:[ownerId],references:[id]) type String make String model String registrationLast4 String seatCount Int verificationStatus VerificationStatus @default(NOT_STARTED) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt rides Ride[] }
model Ride { id String @id @default(cuid()) driverId String driver User @relation("Driver",fields:[driverId],references:[id]) vehicleId String? vehicle Vehicle? @relation(fields:[vehicleId],references:[id]) startLocation String destination String startLat Float startLng Float destinationLat Float destinationLng Float departureAt DateTime availableSeats Int status RideStatus @default(CREATED) estimatedDistance Float estimatedCost Int suggestedContribution Int createdAt DateTime @default(now()) updatedAt DateTime @updatedAt requests RideRequest[] }
model RideRequest { id String @id @default(cuid()) rideId String ride Ride @relation(fields:[rideId],references:[id]) passengerId String passenger User @relation(fields:[passengerId],references:[id]) pickupLocation String dropoffLocation String matchScore Int suggestedContribution Int status RequestStatus @default(PENDING) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([rideId,passengerId]) }
model Block { id String @id @default(cuid()) blockerId String blockedId String blocker User @relation("Blocker",fields:[blockerId],references:[id]) blocked User @relation("Blocked",fields:[blockedId],references:[id]) createdAt DateTime @default(now()) @@unique([blockerId,blockedId]) }
